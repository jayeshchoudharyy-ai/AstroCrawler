# Resend API Key for sending email reports
# Get your free API key at https://resend.com
RESEND_API_KEY=re_your_api_key_here

# Sender address (Resend free tier default is onboarding@resend.dev)
RESEND_FROM="AstroCrawler <onboarding@resend.dev>"

# Monitored URLs (comma or newline separated)
MONITORED_URLS="https://grow.askpuran.com/,https://grow.askpuran.com/reiki-fb/"

# Default expected Razorpay link
DEFAULT_RAZORPAY_LINK=https://pages.razorpay.com/

# Optional secret to secure cron webhook endpoint (/api/cron)
CRON_SECRET=
